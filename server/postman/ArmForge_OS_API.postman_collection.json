{
  "info": {
    "name": "ArmForge OS - Tournament Management API",
    "_postman_id": "armforge-os-api-collection-2026",
    "description": "Complete REST API collection for ArmForge OS covering Authentication, Tournaments, Athletes & Weigh-in Desk, Category Bracket Generation, and Live Match Scoring Pad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "tournamentId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "athleteId", "value": "", "type": "string" },
    { "key": "matchId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Health & System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"organizer_admin\",\n  \"email\": \"admin@armforge.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@armforge.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Tournaments",
      "item": [
        {
          "name": "Create Tournament",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"National Arm Wrestling Championship 2026\",\n  \"venue\": \"Kathmandu Sports Arena, Table 1-3\",\n  \"eventDate\": \"2026-09-15T09:00:00.000Z\",\n  \"tablesCount\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tournaments", "host": ["{{baseUrl}}"], "path": ["api", "tournaments"] }
          }
        },
        {
          "name": "Get All Tournaments",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tournaments", "host": ["{{baseUrl}}"], "path": ["api", "tournaments"] }
          }
        },
        {
          "name": "Get Tournament Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tournaments/{{tournamentId}}", "host": ["{{baseUrl}}"], "path": ["api", "tournaments", "{{tournamentId}}"] }
          }
        },
        {
          "name": "Get Staged Table Queues (On Table, On Deck, In The Hole)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tournaments/{{tournamentId}}/tables/queue", "host": ["{{baseUrl}}"], "path": ["api", "tournaments", "{{tournamentId}}", "tables", "queue"] }
          }
        }
      ]
    },
    {
      "name": "3. Athletes & Weigh-In Desk",
      "item": [
        {
          "name": "Register Athlete",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nitesh Shrestha\",\n  \"phone\": \"+977-9800000000\",\n  \"email\": \"nitesh@example.com\",\n  \"club\": \"Himalayan Pullers Club\",\n  \"country\": \"Nepal\",\n  \"armDominance\": \"RIGHT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/athletes", "host": ["{{baseUrl}}"], "path": ["api", "athletes"] }
          }
        },
        {
          "name": "Get Athletes (Filter & Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/athletes?search=Nitesh", "host": ["{{baseUrl}}"], "path": ["api", "athletes"], "query": [{ "key": "search", "value": "Nitesh" }] }
          }
        },
        {
          "name": "Record Official Scale Weigh-In",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officialWeightKg\": 78.4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/athletes/{{athleteId}}/weigh-in", "host": ["{{baseUrl}}"], "path": ["api", "athletes", "{{athleteId}}", "weigh-in"] }
          }
        }
      ]
    },
    {
      "name": "4. Categories & Bracket Generation",
      "item": [
        {
          "name": "Create Category Division",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tournamentId\": \"{{tournamentId}}\",\n  \"name\": \"Senior Men Right -80kg\",\n  \"arm\": \"RIGHT\",\n  \"gender\": \"MEN\",\n  \"division\": \"SENIOR\",\n  \"weightClassLimitKg\": 80,\n  \"isOpenWeight\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Assign Athlete to Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"athleteId\": \"{{athleteId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}/athletes", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}", "athletes"] }
          }
        },
        {
          "name": "Generate Double Elimination Bracket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}/generate-bracket", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}", "generate-bracket"] }
          }
        },
        {
          "name": "Get Visual Bracket Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}/bracket", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}", "bracket"] }
          }
        },
        {
          "name": "Get Category Podium Placements",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}/podium", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}", "podium"] }
          }
        }
      ]
    },
    {
      "name": "5. Matches & Live Scoring Pad",
      "item": [
        {
          "name": "Get Matches for Tournament",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/matches?tournamentId={{tournamentId}}", "host": ["{{baseUrl}}"], "path": ["api", "matches"], "query": [{ "key": "tournamentId", "value": "{{tournamentId}}" }] }
          }
        },
        {
          "name": "Call Match to Table (60s Ready Clock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/matches/{{matchId}}/call", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchId}}", "call"] }
          }
        },
        {
          "name": "Start Match ON_TABLE",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/matches/{{matchId}}/start", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchId}}", "start"] }
          }
        },
        {
          "name": "Live Referee Touchpad Score Update",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"athleteAWarnings\": 1,\n  \"athleteAFouls\": 0,\n  \"athleteBWarnings\": 0,\n  \"athleteBFouls\": 1,\n  \"wentToStraps\": true,\n  \"inRefereesGrip\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/matches/{{matchId}}/score", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchId}}", "score"] }
          }
        },
        {
          "name": "Complete Match & Advance Bracket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"winnerId\": \"{{athleteId}}\",\n  \"loserId\": \"{{loserAthleteId}}\",\n  \"winMethod\": \"PIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/matches/{{matchId}}/complete", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchId}}", "complete"] }
          }
        }
      ]
    }
  ]
}
